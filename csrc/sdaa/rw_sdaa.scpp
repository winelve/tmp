// SDAA random walk kernel implementation.
// Uses AT_DISPATCH macros for type dispatch.

#include "rw_sdaa.h"
#include <torch/script.h>
#include <torch_sdaa/sdaa_extension.h>
#include <ATen/ATen.h>
#include <cstdint>

// ─── Uniform Random Walk kernel ───────────────────────────────────────
// Each SPE thread performs one random walk starting from a given node.

__global__ void uniform_random_walk_kernel(
    const int64_t *rowptr, const int64_t *col,
    const int64_t *start, const float *rand, int64_t *out,
    int64_t walk_length, int64_t numel) {
  int tid = threadIdx, nt = threadDim;

  for (int64_t i = tid; i < numel; i += nt) {
    int64_t cur = start[i];
    out[i] = cur;

    int64_t row_start, row_end;
    for (int64_t l = 0; l < walk_length; l++) {
      row_start = rowptr[cur];
      row_end = rowptr[cur + 1];
      cur = col[row_start +
                int64_t(rand[l * numel + i] * (row_end - row_start))];
      out[(l + 1) * numel + i] = cur;
    }
  }
}

torch::Tensor random_walk_sdaa(torch::Tensor rowptr, torch::Tensor col,
                               torch::Tensor start, int64_t walk_length) {
  AT_ASSERTM(rowptr.dim() == 1, "rowptr must be 1D");
  AT_ASSERTM(col.dim() == 1, "col must be 1D");
  AT_ASSERTM(start.dim() == 1, "start must be 1D");

  rowptr = rowptr.contiguous();
  col = col.contiguous();
  start = start.contiguous();

  auto rand = torch::rand({walk_length, start.size(0)},
                          start.options().dtype(torch::kFloat));
  auto out = torch::full({walk_length + 1, start.size(0)}, -1, start.options());

  if (start.numel() == 0)
    return out.t().contiguous();

  auto rowptr_data = rowptr.data_ptr<int64_t>();
  auto col_data = col.data_ptr<int64_t>();
  auto start_data = start.data_ptr<int64_t>();
  auto rand_data = rand.data_ptr<float>();
  auto out_data = out.data_ptr<int64_t>();

  uniform_random_walk_kernel<<<0>>>(
      rowptr_data, col_data, start_data, rand_data, out_data,
      walk_length, start.numel());

  return out.t().contiguous();
}
